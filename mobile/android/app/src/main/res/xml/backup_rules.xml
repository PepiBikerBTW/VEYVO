<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 Auto Backup rules: everything except Capacitor Preferences (CapacitorStorage.xml),
     where VEYVO keeps only secrets (the intervals.icu API key). Android 12+ uses data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
</full-backup-content>
