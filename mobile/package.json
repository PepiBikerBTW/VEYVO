{
  "name": "veyvo-mobile",
  "version": "0.4.0",
  "private": true,
  "description": "VEYVO Android app (Capacitor wrapper around ../src)",
  "type": "module",
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "sync": "node scripts/sync-web.mjs && cap sync android",
    "build:debug": "node scripts/sync-web.mjs && cap sync android && cd android && ./gradlew assembleDebug",
    "build:release": "node scripts/sync-web.mjs && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3"
  }
}
